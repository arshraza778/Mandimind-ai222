# ============================================================================
# Mitanin Signal — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials when ready.
# NEVER commit your actual .env file or API keys to version control.
# ============================================================================

# --- Mitanin Sahayak Multilingual AI Chatbot Configuration ---
# Supported providers: "gemini", "openai", "anthropic", "openai_compatible"
CHATBOT_PROVIDER=gemini
CHATBOT_API_KEY=
CHATBOT_MODEL=gemini-2.5-flash
# Optional custom base URL (required if CHATBOT_PROVIDER=openai_compatible)
CHATBOT_BASE_URL=
CHATBOT_TIMEOUT_SECONDS=25
CHATBOT_RATE_LIMIT_PER_MINUTE=30

# --- Optional Cloud / Server-Side Text-to-Speech (TTS) Configuration ---
# Used when a device does not have a native Chhattisgarhi (hne) voice installed
# Supported providers: "none", "google_cloud_tts", "azure_tts", "openai_compatible_tts"
TTS_PROVIDER=none
TTS_API_KEY=
TTS_BASE_URL=
TTS_VOICE_EN=en-IN-Standard-A
TTS_VOICE_HI=hi-IN-Standard-A
TTS_VOICE_HNE=

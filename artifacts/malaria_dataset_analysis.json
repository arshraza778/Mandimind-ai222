  "data_quality_findings": [
    {
      "id": "misleading_column_header_in_incidence_file",
      "severity": "medium",
      "finding": "In `incidence_per_1000_pop_at_risk.csv`, the target column is named `No. of cases`, but values are floating-point malaria incidence rates per 1,000 population at risk (0.0 to 743.51). Standardized during preprocessing to `incidence_per_1000`."
    },
    {
      "id": "mauritius_all_null_in_reported_numbers",
      "severity": "medium",
      "finding": "Countries with 100% missing reported cases and deaths in `reported_numbers.csv`: [] (18 rows from 2000\u20132017). Excluded from reported-case regression."
    },
    {
      "id": "reported_missing_values_historical_concentration",
      "severity": "medium",
      "finding": "`reported_numbers.csv` has 234 missing `No. of cases` values (12.0%) and 269 missing `No. of deaths` values (13.8%), heavily concentrated in earlier years (2000\u20132007). Missing values are preserved as NaN and never fabricated."
    },
    {
      "id": "estimated_confidence_interval_nulls_for_low_or_point_estimates",
      "severity": "low",
      "finding": "In `estimated_numbers.csv`, `No. of cases_min/max` are NaN in 312/856 rows (36.4%) and `No. of deaths_min/max` are NaN in 332/856 rows (38.8%) when `No. of cases_median` is 0 or a direct point count (e.g., Belize=7, Bhutan=11)."
    },
    {
      "id": "congo_who_region_label_anomaly",
      "severity": "low",
      "finding": "In all three source CSVs, `Congo` is labeled with `WHO Region = Americas` (whereas `Democratic Republic of the Congo` is labeled `Africa`). Preserved as-is in raw audit and documented as a source dataset region-coding anomaly."
    },
    {
      "id": "zero_reported_cases_with_positive_deaths",
      "severity": "low",
      "finding": "Found 28 country-year records in `reported_numbers.csv` where indigenous `No. of cases == 0.0` but `No. of deaths > 0` (e.g., China, Turkey, Argentina), reflecting imported malaria fatalities in countries with zero indigenous transmission."
    },
    {
      "id": "surveillance_underreporting_gap_india",
